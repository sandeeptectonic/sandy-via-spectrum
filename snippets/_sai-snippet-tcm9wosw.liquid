{%- unless pdp_cta_layout == 'side_by_side' or pdp_cta_layout == 'stacked' -%}
  {%- assign pdp_cta_layout = 'side_by_side' -%}
{%- endunless -%}

{%- comment -%}
  Resolve tabs. Two data-source modes share the same item-level shape so
  the strip + panel loop below has one code path. Each item is a hash with
  required `title` + collection-handle, optional `subtitle`, optional
  image URL.

  - 'manual': `content.collection_tabs` is an array authored inline in
    the Studio drop dialog (inline-list prop). Each item: { title,
    subtitle, image: { gid, originalUrl, ... }, collection: { gid,
    handle, title, ... } } — picker output structures captured at write
    time.

  - 'metafield': the merchant points at a JSON metafield via namespace +
    key. The owning resource is auto-detected from page context — product
    on PDP, collection on collection page, otherwise shop. Each item:
    { title, collection_handle, subtitle?, image_url? }.

  Items missing required fields, or whose collection-handle doesn't
  resolve via the storefront `collections` global, are skipped silently;
  fallback HTML comments below record metafield-side configuration
  issues per the project's "Fail Loud" rule.
{%- endcomment -%}
{%- assign data_source = content.data_source | default: 'manual' -%}
{%- unless data_source == 'manual' or data_source == 'metafield' -%}
  {%- assign data_source = 'manual' -%}
{%- endunless -%}

{%- assign metafield_value = nil -%}
{%- assign metafield_owner_label = 'shop' -%}
{%- assign inline_tabs = '' | split: ',' -%}

{%- if data_source == 'metafield' -%}
  {%- assign mf_ns = content.metafield_namespace | default: '' -%}
  {%- assign mf_key = content.metafield_key | default: '' -%}
  {%- if mf_ns != '' and mf_key != '' -%}
    {%- if product -%}
      {%- assign metafield_owner_label = 'product' -%}
      {%- assign metafield_value = product.metafields[mf_ns][mf_key].value -%}
    {%- elsif collection and template contains 'collection' -%}
      {%- assign metafield_owner_label = 'collection' -%}
      {%- assign metafield_value = collection.metafields[mf_ns][mf_key].value -%}
    {%- else -%}
      {%- assign metafield_owner_label = 'shop' -%}
      {%- assign metafield_value = shop.metafields[mf_ns][mf_key].value -%}
    {%- endif -%}
  {%- endif -%}
  {%- if metafield_value -%}
    {%- assign total_tabs = metafield_value.size -%}
  {%- else -%}
    {%- assign total_tabs = 0 -%}
  {%- endif -%}
{%- else -%}
  {%- assign inline_tabs = content.collection_tabs -%}
  {%- if inline_tabs == nil -%}
    {%- assign inline_tabs = '' | split: ',' -%}
  {%- endif -%}
  {%- assign total_tabs = inline_tabs.size -%}
{%- endif -%}

{%- comment -%}── Tab strip style + alignment defaults ──{%- endcomment -%}
{%- assign tab_style = content.tab_style | default: 'pill' -%}
{%- unless tab_style == 'pill' or tab_style == 'underline' or tab_style == 'image_circle' or tab_style == 'card_stacked' -%}
  {%- assign tab_style = 'pill' -%}
{%- endunless -%}
{%- assign tab_align = content.tab_align | default: 'center' -%}
{%- unless tab_align == 'left' or tab_align == 'center' -%}
  {%- assign tab_align = 'center' -%}
{%- endunless -%}

{%- comment -%}
  Merchant-chosen accent color for the active tab — drives pill fill,
  underline color, and image-circle ring uniformly via the
  `--sai-tcm9wosw-tab-active` custom property. Blank/unset → falls back to
  the theme's `--sai-color-primary` (then `--sai-color-fg`).
{%- endcomment -%}
{%- assign tab_active_color = content.tab_active_color | default: '' -%}

{%- comment -%}
  View-all CTA — opt-in per drop. When on, every tab panel gets a button
  below the product grid that navigates to that tab's full collection
  page (`target_collection.url`). Hidden when off OR when the collection
  has no resolvable URL.
{%- endcomment -%}
{%- if content.show_view_all_cta == nil -%}
  {%- assign show_view_all_cta = false -%}
{%- else -%}
  {%- assign show_view_all_cta = content.show_view_all_cta -%}
{%- endif -%}
{%- assign view_all_cta_label = content.view_all_cta_label | default: 'View all' -%}

{%- if heading != blank or description != blank or total_tabs > 0 -%}
  <div class="sai-tcm9wosw">
    {%- if heading != blank -%}
      {%- if section_asset_url != blank -%}
        <div class="sai-tcm9wosw__heading-row sai-tcm9wosw__heading-row--{{ section_asset_position }} sai-tcm9wosw__heading-row--size-{{ section_asset_size }}">
          <img class="sai-tcm9wosw__section-asset"
               src="{{ section_asset_url }}"
               alt=""
               loading="lazy"
               aria-hidden="true" />
          <h2 class="sai-tcm9wosw__heading"{{ heading_border_attr }}><span class="sai-tcm9wosw__heading-text">{{ heading | escape }}</span></h2>
        </div>
      {%- else -%}
        <h2 class="sai-tcm9wosw__heading"{{ heading_border_attr }}><span class="sai-tcm9wosw__heading-text">{{ heading | escape }}</span></h2>
      {%- endif -%}
    {%- endif -%}
    {%- if description != blank -%}
      <p class="sai-tcm9wosw__description">{{ description | escape }}</p>
    {%- endif -%}

    {%- comment -%}
      Pick the iteration source per data_source mode. Tab strip and panel
      loop both iterate the same source — for-loops below branch on
      `data_source` once at the top to resolve each iteration's shared
      locals (`tab_title`, `tab_subtitle`, `tab_image_src`,
      `target_collection`).
    {%- endcomment -%}
    {%- if data_source == 'metafield' -%}
      {%- assign tab_source = metafield_value -%}
    {%- else -%}
      {%- assign tab_source = inline_tabs -%}
    {%- endif -%}

    {%- comment -%}
      Metafield diagnostics. Emit a single inline comment to make
      misconfiguration visible in page source per the project's "Fail
      Loud" rule. Live state only; draft preview rendering surfaces the
      same in the Studio preview iframe.
    {%- endcomment -%}
    {%- if data_source == 'metafield' -%}
      {%- if content.metafield_namespace == blank or content.metafield_key == blank -%}
        <!-- SAI:TAB_COLLECTION:METAFIELD_NOT_CONFIGURED namespace="{{ content.metafield_namespace | default: '' }}" key="{{ content.metafield_key | default: '' }}" -->
      {%- elsif metafield_value == nil -%}
        <!-- SAI:TAB_COLLECTION:METAFIELD_EMPTY owner="{{ metafield_owner_label }}" namespace="{{ content.metafield_namespace }}" key="{{ content.metafield_key }}" -->
      {%- endif -%}
    {%- endif -%}

    {%- comment -%}
      Tab strip. Only rendered when there is more than one tab — a single-tab
      configuration degrades to "show this collection's products" with no
      visible chrome above. data-tab-style/data-tab-align thread the
      merchant's choices to CSS modifiers.
    {%- endcomment -%}
    {%- if total_tabs > 1 -%}
      <div class="sai-tcm9wosw__tabs sai-tcm9wosw__tabs--{{ tab_style }}"
           role="tablist"
           aria-label="Collection tabs"
           data-tab-style="{{ tab_style }}"
           data-tab-align="{{ tab_align }}"
           {%- if tab_active_color != blank %} style="--sai-tcm9wosw-tab-active: {{ tab_active_color | escape }};"{%- endif -%}>
        {%- for item in tab_source -%}
          {%- assign tab_title = '' -%}
          {%- assign tab_subtitle = '' -%}
          {%- assign tab_image_src = '' -%}
          {%- assign target_collection = nil -%}

          {%- if data_source == 'metafield' -%}
            {%- assign tab_title = item.title | default: '' -%}
            {%- assign tab_subtitle = item.subtitle | default: '' -%}
            {%- assign tab_image_src = item.image_url | default: '' -%}
            {%- if item.collection_handle != blank -%}
              {%- assign target_collection = collections[item.collection_handle] -%}
            {%- endif -%}
          {%- else -%}
            {%- assign tab_title = item.title | default: '' -%}
            {%- assign tab_subtitle = item.subtitle | default: '' -%}
            {%- if item.image and item.image.originalUrl -%}
              {%- assign tab_image_src = item.image.originalUrl -%}
            {%- elsif item.image and item.image.previewUrl -%}
              {%- assign tab_image_src = item.image.previewUrl -%}
            {%- endif -%}
            {%- if item.collection and item.collection.handle -%}
              {%- assign target_collection = collections[item.collection.handle] -%}
            {%- endif -%}
          {%- endif -%}

          {%- if tab_title != blank and target_collection != nil -%}
            {%- assign tab_index = forloop.index0 -%}
            {%- comment -%}
              Image renders for both `image_circle` (standalone circle
              above the title) and `pill` (small circle on the left,
              title on the right). The `--has-image` modifier flips the
              chip's flex direction to row in pill mode.
            {%- endcomment -%}
            {%- assign show_tab_image = false -%}
            {%- if tab_image_src != blank -%}
              {%- if tab_style == 'image_circle' or tab_style == 'pill' or tab_style == 'card_stacked' -%}
                {%- assign show_tab_image = true -%}
              {%- endif -%}
            {%- endif -%}
            <button type="button"
                    class="sai-tcm9wosw__tab sai-tcm9wosw__tab--{{ tab_style }}{% if show_tab_image %} sai-tcm9wosw__tab--has-image{% endif %}{% if forloop.first %} is-active{% endif %}"
                    role="tab"
                    id="sai-tcm9wosw-tab-{{ tab_index }}"
                    aria-controls="sai-tcm9wosw-panel-{{ tab_index }}"
                    data-spectrum-tab="{{ tab_index }}"
                    {%- if forloop.first %} aria-selected="true" tabindex="0"{% else %} aria-selected="false" tabindex="-1"{%- endif -%}>
              {%- if show_tab_image -%}
                {%- comment -%}
                  Two-element wrap so the active ring can sit OFFSET from
                  the image (frame border + padding gap on outside,
                  image-with-overflow-hidden on inside). One element
                  alone can't have both `overflow: hidden` for the image
                  AND a visible outside border with a gap.
                {%- endcomment -%}
                <span class="sai-tcm9wosw__tab-image-frame" aria-hidden="true">
                  <span class="sai-tcm9wosw__tab-image">
                    <img src="{{ tab_image_src }}"
                         alt=""
                         loading="lazy"
                         width="64"
                         height="64">
                  </span>
                </span>
              {%- endif -%}
              <span class="sai-tcm9wosw__tab-text">
                <span class="sai-tcm9wosw__tab-title">{{ tab_title | escape }}</span>
                {%- if tab_subtitle != blank -%}
                  {%- if tab_style == 'pill' or tab_style == 'card_stacked' -%}
                    <span class="sai-tcm9wosw__tab-subtitle">{{ tab_subtitle | escape }}</span>
                  {%- endif -%}
                {%- endif -%}
              </span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      Per-tab panels. Each panel re-resolves its `target_collection` per
      data_source mode; the existing `__layout`/`__grid` markup below runs
      inside this loop so each tab gets its own grid + carousel state.
    {%- endcomment -%}
    {%- for item in tab_source -%}
      {%- assign target_collection = nil -%}
      {%- assign _title_check = item.title | default: '' -%}
      {%- if data_source == 'metafield' -%}
        {%- if item.collection_handle != blank -%}
          {%- assign target_collection = collections[item.collection_handle] -%}
        {%- endif -%}
      {%- else -%}
        {%- if item.collection and item.collection.handle -%}
          {%- assign target_collection = collections[item.collection.handle] -%}
        {%- endif -%}
      {%- endif -%}

      {%- if _title_check == blank or target_collection == nil -%}
        {%- continue -%}
      {%- endif -%}

      {%- assign tab_index = forloop.index0 -%}
      {%- assign resolved_count = 0 -%}
      {%- if target_collection.products_count > 0 -%}
        {%- assign resolved_count = target_collection.products_count -%}
        {%- if resolved_count > product_count -%}{%- assign resolved_count = product_count -%}{%- endif -%}
      {%- endif -%}

      {%- comment -%}
        Initial carousel page count for the SSR dots + stepper. Computed
        against mobile cpr (the smallest cards-per-row across viewports) so
        we always render the MAXIMUM number of dots a viewport could need —
        JS then hides the extras on wider viewports. Page size mirrors the
        JS: `pageSize = round(cpr)` (so 1.5 → 2, matching how the carousel
        scrolls).
      {%- endcomment -%}
      {%- assign carousel_page_size = cpr_m | round -%}
      {%- if carousel_page_size < 1 -%}{%- assign carousel_page_size = 1 -%}{%- endif -%}
      {%- assign initial_carousel_pages = resolved_count | times: 1.0 | divided_by: carousel_page_size | ceil -%}
      {%- if initial_carousel_pages < 1 -%}{%- assign initial_carousel_pages = 1 -%}{%- endif -%}

      <div class="sai-tcm9wosw__panel"
           id="sai-tcm9wosw-panel-{{ tab_index }}"
           role="tabpanel"
           aria-labelledby="sai-tcm9wosw-tab-{{ tab_index }}"
           data-spectrum-tab-panel="{{ tab_index }}"
           {%- unless forloop.first %} hidden aria-hidden="true" style="display: none !important"{% endunless -%}>

    {%- if resolved_count > 0 -%}
      <div class="sai-tcm9wosw__layout sai-tcm9wosw__layout--{{ layout }}"
           data-layout="{{ layout }}"
           data-indicator="{{ indicator }}">
        <div class="sai-tcm9wosw__frame">
        <div class="sai-tcm9wosw__grid sai-tcm9wosw__grid--{{ layout }}" style="--sai-tcm9wosw-cpr-m: {{ cpr_m }}; --sai-tcm9wosw-cpr-t: {{ cpr_t }}; --sai-tcm9wosw-cpr-d: {{ cpr_d }}{%- if cta_hover_background != blank %}; --sai-tcm9wosw-cta-hover-bg: {{ cta_hover_background }}{%- endif -%}{%- if cta_hover_text_color != blank %}; --sai-tcm9wosw-cta-hover-fg: {{ cta_hover_text_color }}{%- endif -%}{%- if tertiary_cta_hover_background != blank %}; --sai-tcm9wosw-tertiary-hover-bg: {{ tertiary_cta_hover_background }}{%- endif -%}{%- if tertiary_cta_hover_text_color != blank %}; --sai-tcm9wosw-tertiary-hover-fg: {{ tertiary_cta_hover_text_color }}{%- endif -%}">
        {%- for product in target_collection.products limit: product_count -%}
          {%- comment -%}── Sale state + integer discount % ──{%- endcomment -%}
          {%- assign on_sale = false -%}
          {%- assign discount_pct = 0 -%}
          {%- if product.compare_at_price > 0 and product.compare_at_price > product.price -%}
            {%- assign on_sale = true -%}
            {%- assign discount_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
          {%- endif -%}

          <div class="sai-tcm9wosw__card"
               data-image-aspect="{{ aspect }}"
               {%- if card_hover_shadow %} data-hover-shadow="true"{%- endif -%}
               {%- if card_hover_swap_image %} data-hover-swap="true"{%- endif -%}>
            {%- if show_tertiary_cta and tertiary_icon_svg != blank -%}
              <button type="button"
                      class="sai-tcm9wosw__tertiary-cta sai-tcm9wosw__tertiary-cta--{{ tertiary_cta_position | replace: '_', '-' }}"
                      data-spectrum-atc
                      data-spectrum-action="{{ tertiary_cta_action }}"
                      data-spectrum-pid="{{ product.id }}"
                      data-product-title="{{ product.title | escape }}"
                      aria-label="{{ tertiary_cta_action | replace: '_', ' ' | escape }}">
                {{ tertiary_icon_svg }}
              </button>
            {%- endif -%}
            <a class="sai-tcm9wosw__card-link" href="{{ product.url }}">
              {%- if image_mode == 'carousel' -%}
                {%- assign image_count = product.images | size -%}
                {%- if image_count > 8 -%}{%- assign image_count = 8 -%}{%- endif -%}
                {%- if image_count == 0 -%}
                  <div class="sai-tcm9wosw__image-zone sai-tcm9wosw__image-zone--carousel" style="aspect-ratio: {{ aspect }};"></div>
                {%- else -%}
                  <div class="sai-tcm9wosw__image-zone sai-tcm9wosw__image-zone--carousel" style="aspect-ratio: {{ aspect }};">
                    <div class="sai-tcm9wosw__image-track" data-spectrum-image-track>
                      {%- for img in product.images limit: 8 -%}
                        <div class="sai-tcm9wosw__image-slide" role="group" aria-roledescription="slide" aria-label="Image {{ forloop.index }} of {{ image_count }}">
                          <img
                            class="sai-tcm9wosw__image"
                            src="{{ img | image_url: width: 800 }}"
                            srcset="{{ img | image_url: width: 400 }} 400w,
                                    {{ img | image_url: width: 800 }} 800w,
                                    {{ img | image_url: width: 1200 }} 1200w"
                            sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
                            alt="{{ img.alt | default: product.title | escape }}"
                            style="object-fit: {{ fit }};"
                            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                            {%- if forloop.parentloop.first and forloop.first %} fetchpriority="high"{%- endif %}>
                        </div>
                      {%- endfor -%}
                    </div>
                    {%- if show_image_dots and image_count > 1 -%}
                      <div class="sai-tcm9wosw__image-dots"
                           role="tablist"
                           aria-label="Choose product image"
                           data-position="{{ image_dots_position }}"
                           data-spectrum-image-dots>
                        {%- for i in (1..image_count) -%}
                          <button type="button"
                                  class="sai-tcm9wosw__image-dot{% if forloop.first %} is-active{% endif %}"
                                  aria-label="Show image {{ forloop.index }}"
                                  data-spectrum-image-dot="{{ forloop.index0 }}"
                                  {%- if forloop.first %} aria-selected="true"{% endif -%}></button>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- else -%}
                <div class="sai-tcm9wosw__image-zone" style="aspect-ratio: {{ aspect }};">
                  {%- if product.featured_image -%}
                    <img
                      class="sai-tcm9wosw__image"
                      src="{{ product.featured_image | image_url: width: 800 }}"
                      srcset="{{ product.featured_image | image_url: width: 400 }} 400w,
                              {{ product.featured_image | image_url: width: 800 }} 800w,
                              {{ product.featured_image | image_url: width: 1200 }} 1200w"
                      sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      style="object-fit: {{ fit }};"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      {%- if forloop.first %} fetchpriority="high"{%- endif %}>
                  {%- endif -%}
                  {%- if card_hover_swap_image -%}
                    {%- assign second_image = product.images[1] -%}
                    {%- if second_image -%}
                      <img
                        class="sai-tcm9wosw__image sai-tcm9wosw__image--hover"
                        src="{{ second_image | image_url: width: 800 }}"
                        srcset="{{ second_image | image_url: width: 400 }} 400w,
                                {{ second_image | image_url: width: 800 }} 800w,
                                {{ second_image | image_url: width: 1200 }} 1200w"
                        sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
                        alt=""
                        aria-hidden="true"
                        style="object-fit: {{ fit }};"
                        loading="lazy">
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
              <div class="sai-tcm9wosw__body">
                {%- comment -%}
                  Rating: only render when the merchant opted in AND the product
                  has reviews. Star + numeric value cluster — five filled stars
                  would crowd the small card; this matches the standard
                  product-card pattern.
                {%- endcomment -%}
                {%- assign rating_stats = product.metafields.spectrum.review_stats.value -%}
                {%- assign rating_available = false -%}
                {%- if show_rating and rating_stats and rating_stats.totalCount > 0 -%}
                  {%- assign rating_available = true -%}
                  {%- assign rating_avg = rating_stats.averageRating | times: 1.0 | round: 1 -%}
                  {%- assign rating_count = rating_stats.totalCount -%}
                {%- endif -%}

                {%- capture rating_block -%}
                  {%- if rating_available -%}
                    <span class="sai-tcm9wosw__rating" aria-label="Rated {{ rating_avg }} out of 5 from {{ rating_count }} reviews">
                      <svg class="sai-tcm9wosw__rating-star" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                      </svg>
                      {%- if rating_show_count -%}
                        <span class="sai-tcm9wosw__rating-value">{{ rating_avg }}</span>
                        <span class="sai-tcm9wosw__rating-count">({{ rating_count }})</span>
                      {%- else -%}
                        <span class="sai-tcm9wosw__rating-value">({{ rating_avg }})</span>
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                {%- endcapture -%}

                {%- if rating_available and rating_position == 'title_right' -%}
                  <div class="sai-tcm9wosw__title-row">
                    <h3 class="sai-tcm9wosw__title" data-title-lines="{{ title_lines }}">{{ product.title | escape }}</h3>
                    {{ rating_block }}
                  </div>
                {%- else -%}
                  <h3 class="sai-tcm9wosw__title" data-title-lines="{{ title_lines }}">{{ product.title | escape }}</h3>
                  {%- if rating_available and rating_position == 'below_title' -%}
                    {{ rating_block }}
                  {%- endif -%}
                {%- endif -%}
                {%- if show_swatches -%}
                  {%- comment -%}
                    Find the color option. Prefer the merchant-configured
                    `swatch_option_name`; fall back to "color" / "colour" so
                    typo-tolerant out of the box. `options_with_values` is
                    standard on Online Store 2.0; each value is either a
                    `product_option_value` drop (has `.name` + `.swatch`) or
                    a plain string on older themes — both shapes handled
                    below via `| default: v` and nil-safe `.swatch.x`.
                  {%- endcomment -%}
                  {%- assign swatch_option = nil -%}
                  {%- assign opt_name_lc = swatch_option_name | downcase -%}
                  {%- for o in product.options_with_values -%}
                    {%- assign o_name_lc = o.name | downcase -%}
                    {%- if o_name_lc == opt_name_lc -%}
                      {%- assign swatch_option = o -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if swatch_option == nil -%}
                    {%- for o in product.options_with_values -%}
                      {%- assign o_name_lc = o.name | downcase -%}
                      {%- if o_name_lc == 'color' or o_name_lc == 'colour' -%}
                        {%- assign swatch_option = o -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                  {%- if swatch_option != nil -%}
                    {%- assign sw_total = swatch_option.values | size -%}
                    <div class="sai-tcm9wosw__swatches sai-tcm9wosw__swatches--{{ swatch_shape }}"
                         role="list"
                         aria-label="Available colors">
                      {%- for v in swatch_option.values -%}
                        {%- if forloop.index > smv_max -%}{%- break -%}{%- endif -%}
                        {%- assign val_name = v.name | default: v -%}
                        {%- assign hex = v.swatch.color -%}
                        {%- assign img_src = '' -%}
                        {%- if v.swatch.image != blank -%}
                          {%- assign img_src = v.swatch.image | image_url: width: 60 -%}
                        {%- endif -%}
                        <span class="sai-tcm9wosw__swatch"
                              role="listitem"
                              title="{{ val_name | escape }}"
                              aria-label="{{ val_name | escape }}"
                              {%- if forloop.index > smv_m %} data-hide-m{% endif -%}
                              {%- if forloop.index > smv_t %} data-hide-t{% endif -%}
                              {%- if forloop.index > smv_d %} data-hide-d{% endif -%}
                              style="{%- if hex != blank -%}background-color: {{ hex }};{%- elsif img_src != blank -%}background-image: url({{ img_src }}); background-size: cover; background-position: center;{%- endif -%}"></span>
                      {%- endfor -%}
                      {%- assign more_m = sw_total | minus: smv_m -%}
                      {%- assign more_t = sw_total | minus: smv_t -%}
                      {%- assign more_d = sw_total | minus: smv_d -%}
                      {%- if more_m > 0 -%}<span class="sai-tcm9wosw__swatch-more sai-tcm9wosw__swatch-more--m" aria-hidden="true">+{{ more_m }}</span>{%- endif -%}
                      {%- if more_t > 0 -%}<span class="sai-tcm9wosw__swatch-more sai-tcm9wosw__swatch-more--t" aria-hidden="true">+{{ more_t }}</span>{%- endif -%}
                      {%- if more_d > 0 -%}<span class="sai-tcm9wosw__swatch-more sai-tcm9wosw__swatch-more--d" aria-hidden="true">+{{ more_d }}</span>{%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
                {%- if show_price_label or show_current_price or show_mrp or show_discount -%}
                  <div class="sai-tcm9wosw__price-block">
                    {%- if show_price_label and price_label_text != blank -%}
                      <div class="sai-tcm9wosw__price-label">{{ price_label_text | escape }}</div>
                    {%- endif -%}
                    {%- capture price_current_span -%}
                      {%- if show_current_price -%}
                        {%- if hide_price_decimals -%}
                          <span class="sai-tcm9wosw__price-current">{{ product.price | money_without_trailing_zeros }}</span>
                        {%- else -%}
                          <span class="sai-tcm9wosw__price-current">{{ product.price | money }}</span>
                        {%- endif -%}
                      {%- endif -%}
                    {%- endcapture -%}
                    {%- capture price_mrp_span -%}
                      {%- if on_sale and show_mrp -%}
                        {%- if hide_price_decimals -%}
                          <span class="sai-tcm9wosw__price-mrp">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
                        {%- else -%}
                          <span class="sai-tcm9wosw__price-mrp">{{ product.compare_at_price | money }}</span>
                        {%- endif -%}
                      {%- endif -%}
                    {%- endcapture -%}
                    {%- capture price_discount_span -%}
                      {%- if on_sale and show_discount -%}
                        <span class="sai-tcm9wosw__price-discount">{{ discount_pct }}% OFF</span>
                      {%- endif -%}
                    {%- endcapture -%}
                    <div class="sai-tcm9wosw__price-row">
                      {%- case price_order -%}
                        {%- when 'mrp_current_discount' -%}{{ price_mrp_span }}{{ price_current_span }}{{ price_discount_span }}
                        {%- when 'current_discount_mrp' -%}{{ price_current_span }}{{ price_discount_span }}{{ price_mrp_span }}
                        {%- else -%}{{ price_current_span }}{{ price_mrp_span }}{{ price_discount_span }}
                      {%- endcase -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </a>
            {%- if show_cta -%}
              {%- comment -%}
                Click-routing attributes — see v5vphgd8 for the full
                explanation. JS reads `data-spectrum-primary-action` to
                route into the right handler.
              {%- endcomment -%}
              {%- assign use_cta_row = false -%}
              {%- if show_secondary_cta and secondary_cta_style != 'text_below' -%}
                {%- assign use_cta_row = true -%}
              {%- endif -%}
              {%- if use_cta_row -%}
                <div class="sai-tcm9wosw__cta-row sai-tcm9wosw__cta-row--{{ secondary_cta_style | replace: '_', '-' }}">
              {%- endif -%}
              {%- if use_cta_row and secondary_cta_style == 'icon_left' -%}
                <button type="button"
                        class="sai-tcm9wosw__secondary-cta sai-tcm9wosw__secondary-cta--icon"
                        data-spectrum-atc
                        data-spectrum-action="{{ secondary_cta_action }}"
                        data-spectrum-pid="{{ product.id }}"
                        data-product-title="{{ product.title | escape }}"
                        aria-label="{{ secondary_cta_action | replace: '_', ' ' | escape }}">
                  {{ secondary_icon_svg }}
                </button>
              {%- endif -%}
              <a class="sai-tcm9wosw__cta"
                 href="{{ product.url }}"
                 {%- if cta_intercepts_click -%}
                 data-spectrum-atc
                 data-spectrum-action="{{ primary_cta_action }}"
                 data-spectrum-primary-action="{{ primary_cta_action }}"
                 data-spectrum-pid="{{ product.id }}"
                 data-product-title="{{ product.title | escape }}"
                 data-sold-out-label="{{ sold_out_label | escape }}"
                 {%- endif -%}
                 {%- if cta_emits_theme_atc -%}
                 data-product-id="{{ product.id }}"
                 {%- endif -%}>{{ cta_label | escape }}</a>
              {%- if use_cta_row and secondary_cta_style == 'icon_right' -%}
                <button type="button"
                        class="sai-tcm9wosw__secondary-cta sai-tcm9wosw__secondary-cta--icon"
                        data-spectrum-atc
                        data-spectrum-action="{{ secondary_cta_action }}"
                        data-spectrum-pid="{{ product.id }}"
                        data-product-title="{{ product.title | escape }}"
                        aria-label="{{ secondary_cta_action | replace: '_', ' ' | escape }}">
                  {{ secondary_icon_svg }}
                </button>
              {%- endif -%}
              {%- if use_cta_row -%}
                </div>
              {%- endif -%}
              {%- if show_secondary_cta and secondary_cta_style == 'text_below' -%}
                <button type="button"
                        class="sai-tcm9wosw__secondary-cta sai-tcm9wosw__secondary-cta--text-below"
                        data-spectrum-atc
                        data-spectrum-action="{{ secondary_cta_action }}"
                        data-spectrum-pid="{{ product.id }}"
                        data-product-title="{{ product.title | escape }}">
                  {{ secondary_icon_svg }}
                  <span class="sai-tcm9wosw__secondary-cta-label">{{ secondary_cta_label | escape }}</span>
                </button>
              {%- endif -%}
              {%- if cta_needs_payload -%}
              {%- comment -%}
                Per-card payload — feeds the inline Mini-PDP modal (when
                enabled). Includes everything the modal renders (gallery
                images, description, full variant data with prices +
                inventory). Every interpolated value pipes through `| json`.
              {%- endcomment -%}
              <script type="application/json" data-spectrum-atc-data="{{ product.id }}">
              {
                "productId": {{ product.id | json }},
                "title": {{ product.title | json }},
                "url": {{ product.url | json }},
                "description": {{ product.description | json }},
                "images": [
                  {%- for img in product.images limit: 8 -%}
                    {{ img | image_url: width: 1200 | json }}{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ],
                "variants": [
                  {%- for v in product.variants -%}
                    {
                      "id": {{ v.id | json }},
                      "title": {{ v.title | json }},
                      "available": {{ v.available | json }},
                      {%- if hide_price_decimals -%}
                      "price": {{ v.price | money_without_trailing_zeros | json }},
                      "compareAtPrice": {{ v.compare_at_price | money_without_trailing_zeros | json }},
                      {%- else -%}
                      "price": {{ v.price | money | json }},
                      "compareAtPrice": {{ v.compare_at_price | money | json }},
                      {%- endif -%}
                      "inventoryQuantity": {{ v.inventory_quantity | json }}
                    }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ]
              }
              </script>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
        </div>

        {%- if layout == 'carousel' and carousel_arrows -%}
          <button type="button"
                  class="sai-tcm9wosw__arrow sai-tcm9wosw__arrow--prev"
                  aria-label="Previous"
                  data-spectrum-carousel-arrow="prev">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3.5L5.5 8L10 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button"
                  class="sai-tcm9wosw__arrow sai-tcm9wosw__arrow--next"
                  aria-label="Next"
                  data-spectrum-carousel-arrow="next">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 3.5L10.5 8L6 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {%- endif -%}
        </div>

        {%- if layout == 'carousel' and indicator != 'none' -%}
          <div class="sai-tcm9wosw__controls" data-card-count="{{ resolved_count }}">
            {%- if indicator == 'dots' -%}
              <div class="sai-tcm9wosw__dots" role="tablist" aria-label="Carousel position">
                {%- for n in (1..initial_carousel_pages) -%}
                  <button type="button"
                          class="sai-tcm9wosw__dot{% if forloop.first %} is-active{% endif %}"
                          aria-label="Go to slide {{ forloop.index }}"
                          data-spectrum-carousel-dot="{{ forloop.index0 }}"
                          {%- if forloop.first %} aria-selected="true"{% endif -%}></button>
                {%- endfor -%}
              </div>
            {%- elsif indicator == 'scroll_bar' -%}
              <div class="sai-tcm9wosw__scrollbar" aria-hidden="true">
                <div class="sai-tcm9wosw__scrollbar-thumb" data-spectrum-carousel-thumb></div>
              </div>
            {%- elsif indicator == 'stepper' -%}
              <div class="sai-tcm9wosw__stepper" aria-live="polite" data-spectrum-carousel-stepper>1 / {{ initial_carousel_pages }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

      {%- comment -%}
        View-all CTA — per-tab. Points at the active tab's collection URL.
        Suppressed when the merchant disabled the CTA OR when the collection
        drop has no `.url` (e.g. the collection was deleted but the
        metafield handle is stale).
      {%- endcomment -%}
      {%- if show_view_all_cta and target_collection.url != blank -%}
        <div class="sai-tcm9wosw__view-all">
          <a class="sai-tcm9wosw__view-all-link" href="{{ target_collection.url }}">
            <span class="sai-tcm9wosw__view-all-label">{{ view_all_cta_label | escape }}</span>
            <svg class="sai-tcm9wosw__view-all-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M5.5 3.5L10 8L5.5 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      {%- endif -%}
      </div>
    {%- endfor -%}

    {%- comment -%}
      Mini-PDP — full quick-view modal.  One singleton modal serves every
      tab panel; the click target reads its product data from the per-card
      `data-spectrum-atc-data` script payload regardless of which panel it
      sits in. Hidden until JS opens it; lives outside any tab panel so its
      `position: fixed` styling doesn't fight the layout/grid.
    {%- endcomment -%}
    {%- if show_cta and total_tabs > 0 and mini_pdp_will_render -%}
      <div class="sai-tcm9wosw__pdp sai-tcm9wosw__pdp--gallery-{{ pdp_gallery_style }} sai-tcm9wosw__pdp--width-{{ pdp_modal_max_width }} sai-tcm9wosw__pdp--radius-{{ pdp_modal_border_radius }}"
           data-spectrum-pdp-modal
           hidden>
        <div class="sai-tcm9wosw__pdp-backdrop" data-spectrum-pdp-backdrop></div>
        <div class="sai-tcm9wosw__pdp-panel"
             role="dialog"
             aria-modal="true"
             aria-labelledby="sai-tcm9wosw-pdp-title"
             data-spectrum-pdp-panel>

          <button type="button"
                  class="sai-tcm9wosw__pdp-close"
                  data-spectrum-pdp-close
                  aria-label="Close">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>

          <div class="sai-tcm9wosw__pdp-layout">
            <div class="sai-tcm9wosw__pdp-gallery"
                 style="aspect-ratio: {{ pdp_gallery_aspect_ratio }};"
                 data-spectrum-pdp-gallery>
              <div class="sai-tcm9wosw__pdp-track" data-spectrum-pdp-track></div>

              {%- if pdp_show_chevrons -%}
                <button type="button"
                        class="sai-tcm9wosw__pdp-chevron sai-tcm9wosw__pdp-chevron--prev"
                        data-spectrum-pdp-chevron="prev"
                        aria-label="Previous image"
                        hidden>
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3.5L5.5 8L10 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button type="button"
                        class="sai-tcm9wosw__pdp-chevron sai-tcm9wosw__pdp-chevron--next"
                        data-spectrum-pdp-chevron="next"
                        aria-label="Next image"
                        hidden>
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 3.5L10.5 8L6 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              {%- endif -%}

              {%- if pdp_show_dots -%}
                <div class="sai-tcm9wosw__pdp-dots" role="tablist" aria-label="Gallery position" data-spectrum-pdp-dots hidden></div>
              {%- endif -%}

              <div class="sai-tcm9wosw__pdp-overlay-actions">
                {%- if pdp_show_share_button -%}
                  <button type="button"
                          class="sai-tcm9wosw__pdp-share"
                          data-spectrum-pdp-share
                          aria-label="Share product">
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <circle cx="3" cy="8" r="2" fill="none" stroke="currentColor" stroke-width="1.3"/>
                      <circle cx="12" cy="3.5" r="2" fill="none" stroke="currentColor" stroke-width="1.3"/>
                      <circle cx="12" cy="12.5" r="2" fill="none" stroke="currentColor" stroke-width="1.3"/>
                      <path d="M5 7L10 4M5 9L10 12" fill="none" stroke="currentColor" stroke-width="1.3"/>
                    </svg>
                  </button>
                {%- endif -%}
                {%- if pdp_show_view_product_cta -%}
                  <a class="sai-tcm9wosw__pdp-view-product"
                     href="#"
                     data-spectrum-pdp-view-product
                     aria-label="View full product page">
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <path d="M9 2h5v5M14 2L8 8M12 9v4a1 1 0 01-1 1H3a1 1 0 01-1-1V5a1 1 0 011-1h4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                {%- endif -%}
              </div>
            </div>

            <div class="sai-tcm9wosw__pdp-content">

              <h3 class="sai-tcm9wosw__pdp-title"
                  id="sai-tcm9wosw-pdp-title"
                  data-spectrum-pdp-title></h3>

              {%- if pdp_show_selling_price or pdp_show_mrp or pdp_show_discount_badge -%}
                <div class="sai-tcm9wosw__pdp-price-row" data-spectrum-pdp-price-row>
                  {%- if pdp_show_selling_price -%}
                    <span class="sai-tcm9wosw__pdp-price-current" data-spectrum-pdp-price-current></span>
                  {%- endif -%}
                  {%- if pdp_show_mrp -%}
                    <span class="sai-tcm9wosw__pdp-price-mrp" data-spectrum-pdp-price-mrp hidden></span>
                  {%- endif -%}
                  {%- if pdp_show_discount_badge -%}
                    <span class="sai-tcm9wosw__pdp-discount" data-spectrum-pdp-discount hidden></span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if pdp_show_variant_selector -%}
                <div class="sai-tcm9wosw__pdp-variants sai-tcm9wosw__pdp-variants--{{ pdp_variant_selector_style }}"
                     data-spectrum-pdp-variants
                     role="radiogroup"
                     aria-label="Choose a variant"></div>
              {%- endif -%}

              {%- if pdp_show_low_inventory_callout -%}
                <div class="sai-tcm9wosw__pdp-low-stock"
                     data-spectrum-pdp-low-stock
                     role="status"
                     hidden>
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M8 1.5l1 4 4 .5-3 3 1 4-3-2-3 2 1-4-3-3 4-.5z" fill="currentColor"/>
                  </svg>
                  <span data-spectrum-pdp-low-stock-text></span>
                </div>
              {%- endif -%}

              {%- if pdp_show_quantity_selector -%}
                <div class="sai-tcm9wosw__pdp-qty" data-spectrum-pdp-qty-row>
                  <label class="sai-tcm9wosw__pdp-qty-label" for="sai-tcm9wosw-pdp-qty">Quantity</label>
                  <div class="sai-tcm9wosw__pdp-qty-stepper">
                    <button type="button" class="sai-tcm9wosw__pdp-qty-button" data-spectrum-pdp-qty-decrement aria-label="Decrease quantity">−</button>
                    <input id="sai-tcm9wosw-pdp-qty"
                           class="sai-tcm9wosw__pdp-qty-input"
                           type="number"
                           min="1"
                           step="1"
                           value="1"
                           data-spectrum-pdp-qty-input
                           inputmode="numeric">
                    <button type="button" class="sai-tcm9wosw__pdp-qty-button" data-spectrum-pdp-qty-increment aria-label="Increase quantity">+</button>
                  </div>
                </div>
              {%- endif -%}

              {%- if pdp_show_description -%}
                <div class="sai-tcm9wosw__pdp-description sai-tcm9wosw__pdp-description--{{ pdp_description_style }} sai-tcm9wosw__pdp-description--font-{{ pdp_description_font_size }}"
                     data-spectrum-pdp-description>
                  <div class="sai-tcm9wosw__pdp-description-body" data-spectrum-pdp-description-body></div>
                  {%- if pdp_description_style == 'expandable' -%}
                    <button type="button"
                            class="sai-tcm9wosw__pdp-description-toggle"
                            data-spectrum-pdp-description-toggle
                            aria-expanded="false"
                            hidden>Read more</button>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if pdp_show_add_to_cart or pdp_show_buy_now -%}
                <div class="sai-tcm9wosw__pdp-ctas sai-tcm9wosw__pdp-ctas--{{ pdp_cta_layout }}">
                  {%- if pdp_show_buy_now -%}
                    <button type="button"
                            class="sai-tcm9wosw__pdp-buy-now"
                            data-spectrum-pdp-buy-now>{{ pdp_buy_now_label | escape }}</button>
                  {%- endif -%}
                  {%- if pdp_show_add_to_cart -%}
                    <button type="button"
                            class="sai-tcm9wosw__pdp-atc"
                            data-spectrum-pdp-atc>{{ pdp_atc_label | escape }}</button>
                  {%- endif -%}
                </div>
              {%- endif -%}

            </div>
          </div>
        </div>

        <script type="application/json" data-spectrum-pdp-config>
          {
            "galleryStyle": {{ pdp_gallery_style | json }},
            "showChevrons": {{ pdp_show_chevrons | json }},
            "showDots": {{ pdp_show_dots | json }},
            "autoPlay": {{ pdp_auto_play | json }},
            "showSellingPrice": {{ pdp_show_selling_price | json }},
            "showMrp": {{ pdp_show_mrp | json }},
            "showDiscountBadge": {{ pdp_show_discount_badge | json }},
            "discountFormat": {{ pdp_discount_format | json }},
            "showVariantSelector": {{ pdp_show_variant_selector | json }},
            "variantSelectorStyle": {{ pdp_variant_selector_style | json }},
            "showPriceInVariant": {{ pdp_show_price_in_variant | json }},
            "showLowInventoryCallout": {{ pdp_show_low_inventory_callout | json }},
            "lowInventoryThreshold": {{ pdp_low_inventory_threshold | json }},
            "lowInventoryText": {{ pdp_low_inventory_text | json }},
            "showQuantitySelector": {{ pdp_show_quantity_selector | json }},
            "showDescription": {{ pdp_show_description | json }},
            "descriptionStyle": {{ pdp_description_style | json }},
            "soldOutLabel": {{ sold_out_label | json }}
          }
        </script>
      </div>
    {%- endif -%}
  </div>
  {%- comment -%}
    Asset is only useful when the wrapper rendered — no container means no
    work for the IIFE. Keep the tag inside the guard so off-state pages
    (no collection picked, empty source) don't load ~40 KB of script.
  {%- endcomment -%}
  <script src="{{ 'sai-snippet-tcm9wosw.js' | asset_url }}" async></script>
{%- endif -%}
