{{ 'section-shoppable-videos.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-shoppable-videos-simple.js' | asset_url }}"></script>

{%- liquid
  assign section_id = 'shoppable-videos-' | append: section.id

  # Determine data source based on template
  if template.name == 'product'
    # On product page, use product metafield
    assign videos = product.metafields.custom.SPECTRUM_shoppable_videos.value
    assign is_product_page = true
  else
    # On homepage or other pages, use all metaobject entries
    assign videos = shop.metaobjects.SPECTRUM_shoppable_videos.values
    assign is_product_page = false
  endif
-%}

<section id="{{ section_id }}" class="shoppable-videos section {% if section.settings.padding_top %}section--padding-top{% endif %} {% if section.settings.padding_bottom %}section--padding-bottom{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="shoppable-videos__header">
        <h2 class="shoppable-videos__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    {%- comment -%} Debug: Log all metaobject data {%- endcomment -%}
    <script>
      console.log('🔍 DEBUG: Videos data structure:');
      console.log('Videos count:', {{ videos.size | json }});
      {% for video in videos limit: section.settings.videos_to_show %}
      console.log('Video {{ forloop.index }}:');
      console.log('  - Full video object:', {{ video | json }});
      console.log('  - video.video field:', {{ video.video | json }});
      console.log('  - video.video.value:', {{ video.video.value | json }});
      console.log('  - video.title:', {{ video.title | json }});
      console.log('  - video.title.value:', {{ video.title.value | json }});
      console.log('  - video.products:', {{ video.products | json }});
      {% if video.video.value %}
      console.log('  - video.video.value properties:');
      console.log('    - url:', {{ video.video.value.url | json }});
      console.log('    - alt:', {{ video.video.value.alt | json }});
      console.log('    - width:', {{ video.video.value.width | json }});
      console.log('    - height:', {{ video.video.value.height | json }});
      console.log('  - video file_url filter:', {{ video.video.value | file_url | json }});
      {% endif %}
      console.log('---');
      {% endfor %}
    </script>

    {%- if videos != blank and videos.size > 0 -%}
      <div class="shoppable-videos__grid" data-videos-count="{{ videos.size }}">
        {%- for video in videos limit: section.settings.videos_to_show -%}
          {%- assign video_id = 'video-' | append: forloop.index -%}
          <div class="shoppable-videos__item" data-video-index="{{ forloop.index }}">
            <button
              class="shoppable-videos__trigger"
              type="button"
              aria-label="Play {{ video.title.value }}"
              data-video-id="{{ video_id }}"
              data-video-url="{%- if video.video.value -%}{{ video.video.value.url | default: video.video.value.sources[0].url | default: video.video.value }}{%- endif -%}"
              data-video-title="{{ video.title.value | escape }}"
              data-debug-video="{{ video.video | json }}"
              {%- unless video.video.value -%}data-no-video="true"{%- endunless -%}
            >
              <div class="shoppable-videos__thumbnail">
                {%- if video.video.value.preview_image -%}
                  {{ video.video.value.preview_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: video.title.value }}
                {%- else -%}
                  <div class="shoppable-videos__placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                {%- endif -%}
                <div class="shoppable-videos__play-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
              <h3 class="shoppable-videos__title">{{ video.title.value }}</h3>
            </button>

            {%- comment -%} Store product data for modal {%- endcomment -%}
            {%- if video.products.value.size > 0 -%}
              <script type="application/json" data-products-for="{{ video_id }}">
                [
                  {%- for product in video.products.value -%}
                    {
                      "id": {{ product.id | json }},
                      "title": {{ product.title | json }},
                      "handle": {{ product.handle | json }},
                      "price": {{ product.price | money | json }},
                      "compare_at_price": {{ product.compare_at_price | money | json }},
                      "image": {{ product.featured_image | image_url: width: 300 | json }},
                      "available": {{ product.available | json }},
                      "variant_id": {{ product.selected_or_first_available_variant.id | json }},
                      "url": {{ product.url | json }}
                    }{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                ]
              </script>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="shoppable-videos__empty">
        <p>{{ section.settings.empty_message | default: 'No videos available' }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%} Modal Structure {%- endcomment -%}
<div id="{{ section_id }}-modal" class="shoppable-videos-modal" aria-hidden="true">
  <div class="shoppable-videos-modal__backdrop"></div>
  <div class="shoppable-videos-modal__content" role="dialog" aria-modal="true">
    <button class="shoppable-videos-modal__close" type="button" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="shoppable-videos-modal__video">
      <video class="shoppable-videos-modal__player" controls playsinline muted preload="metadata"></video>
    </div>

    <div class="shoppable-videos-modal__products">
      <h3 class="shoppable-videos-modal__products-title">{{ section.settings.modal_products_heading | default: 'Shop this video' }}</h3>
      <div class="shoppable-videos-modal__products-grid"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shoppable Videos",
  "tag": "section",
  "class": "section-shoppable-videos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Our Videos"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h0",
          "label": "Extra Large"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h3",
          "label": "Small"
        }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "videos_to_show",
      "label": "Videos to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty state message",
      "default": "No videos available"
    },
    {
      "type": "text",
      "id": "modal_products_heading",
      "label": "Modal products heading",
      "default": "Shop this video"
    },
    {
      "type": "checkbox",
      "id": "padding_top",
      "label": "Add top padding",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "padding_bottom",
      "label": "Add bottom padding",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Shoppable Videos"
    }
  ]
}
{% endschema %}