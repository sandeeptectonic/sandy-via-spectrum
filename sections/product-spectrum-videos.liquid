{%- liquid
  # Get videos for current product
  assign product_videos = product.metafields.custom.SPECTRUM_product_videos.value

  # Fallback: Find videos that contain this product using spectrum_sv_video metaobjects
  if product_videos == blank
    assign all_videos = shop.metaobjects.spectrum_sv_video.values
    assign product_videos = blank | split: ','
    for video in all_videos
      if video.products_contained.value contains product
        assign product_videos = product_videos | push: video
      endif
    endfor
  endif

  # Set widget type for PDP
  assign widget_type = 'pdp'
-%}

{%- if product_videos != blank and product_videos.size > 0 -%}
  <link rel="stylesheet" href="{{ 'section-spectrum-carousel.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'section-spectrum-carousel.css' | asset_url | stylesheet_tag }}</noscript>
  <script src="{{ 'section-spectrum-carousel.js' | asset_url }}" type="module" fetchpriority="low"></script>

  <section class="product-spectrum-videos spectrum-carousel-videos section" data-section-id="{{ section.id }}" {{ section.shopify_attributes }}>
    <div class="section-background color-{{ section.settings.color_scheme }}"></div>
    <div class="section--page-width">
      {%- if section.settings.heading != blank -%}
        <div class="spectrum-carousel__header">
          <h2 class="spectrum-carousel__heading h2">{{ section.settings.heading }}</h2>
          {%- if section.settings.description != blank -%}
            <p class="spectrum-carousel__description">{{ section.settings.description }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="spectrum-carousel__container"
           data-spectrum-widget='{"type":"{{ widget_type }}","id":"{{ section.id }}","context":"pdp","productId":"{{ product.id }}"}'>
        <div class="spectrum-carousel__track">
          {%- for video in product_videos limit: section.settings.max_videos -%}
            {%- assign video_id = 'video-' | append: section.id | append: '-' | append: forloop.index -%}
            <div class="spectrum-carousel__slide">
              <button class="spectrum-carousel__trigger"
                      type="button"
                      data-video-id="{{ video_id }}"
                      data-video-index="{{ forloop.index0 }}"
                      data-video-url="{%- if video.video_file.value.sources.first -%}{{ video.video_file.value.sources.first.url }}{%- endif -%}"
                      data-video-title="{{ video.title.value | escape }}"
                      data-product-id="{{ product.id }}">
                <div class="spectrum-carousel__thumbnail">
                  {%- if video.thumbnail.value -%}
                    <img src="{{ video.thumbnail.value | image_url: width: 400 }}"
                         alt="{{ video.title.value | escape }}"
                         loading="lazy"
                         width="400"
                         height="480">
                  {%- elsif video.video_file.value -%}
                    {%- if video.video_file.value.sources.first -%}
                      <video class="spectrum-carousel__preview"
                             autoplay muted loop playsinline
                             preload="metadata"
                             src="{{ video.video_file.value.sources.first.url }}">
                      </video>
                    {%- else -%}
                      {{ video.video_file.value | video_tag: autoplay: true, muted: true, loop: true, controls: false, class: 'spectrum-carousel__preview' }}
                    {%- endif -%}
                  {%- endif -%}

                  <div class="spectrum-carousel__overlay">
                    <div class="spectrum-carousel__info">
                      <h3>{{ video.title.value }}</h3>
                      {%- if video.products_contained.value != blank and video.products_contained.value.size > 0 -%}
                        <p>{{ video.products_contained.value.size }}
                          {%- if video.products_contained.value.size == 1 -%}product{%- else -%}products{%- endif -%}</p>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </button>

            </div>
          {%- endfor -%}
        </div>

        {%- if product_videos.size > 1 -%}
          <div class="spectrum-carousel__nav">
            <button class="spectrum-carousel__nav-prev" type="button" aria-label="Previous">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                <path d="M15 18l-6-6 6-6" stroke-width="2"/>
              </svg>
            </button>
            <button class="spectrum-carousel__nav-next" type="button" aria-label="Next">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                <path d="M9 18l6-6-6-6" stroke-width="2"/>
              </svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} Modal container {%- endcomment -%}
  <div id="spectrum-modal-{{ section.id }}" class="spectrum-modal" aria-hidden="true"></div>

  {%- comment -%} Hidden product data for each video {%- endcomment -%}
  {%- for video in product_videos limit: section.settings.max_videos -%}
    {%- assign video_id = 'video-' | append: section.id | append: '-' | append: forloop.index -%}

    {%- comment -%} Product data for modal - prioritize current product {%- endcomment -%}
    {%- assign modal_products = blank | split: ',' -%}
    {%- assign modal_products = modal_products | push: product -%}
    {%- if video.products_contained.value != blank -%}
      {%- for video_product in video.products_contained.value -%}
        {%- unless video_product.id == product.id -%}
          {%- assign modal_products = modal_products | push: video_product -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if modal_products.size > 0 -%}
      <script type="application/json" data-modal-products-for="{{ video_id }}">
        [
          {%- for modal_product in modal_products -%}
            {
              "id": {{ modal_product.id | json }},
              "title": {{ modal_product.title | json }},
              "handle": {{ modal_product.handle | json }},
              "price": {{ modal_product.price | money | json }},
              "image": {{ modal_product.featured_image | image_url: width: 300 | json }},
              "available": {{ modal_product.available | json }},
              "url": {{ modal_product.url | json }},
              "isPrimary": {% if modal_product.id == product.id %}true{% else %}false{% endif %}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      </script>
    {%- endif -%}
  {%- endfor -%}

{%- else -%}
  {%- if section.settings.show_when_empty -%}
    <section class="product-spectrum-videos spectrum-carousel-videos section" {{ section.shopify_attributes }}>
      <div class="section--page-width">
        <div class="spectrum-carousel__empty">
          <p>{{ section.settings.empty_message | default: 'No videos available for this product' }}</p>
        </div>
      </div>
    </section>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Product Spectrum Videos",
  "tag": "section",
  "class": "section-product-spectrum-videos",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See it in Action"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "max_videos",
      "label": "Maximum videos to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_when_empty",
      "label": "Show section when no videos",
      "default": false
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty state message",
      "default": "No videos available for this product"
    }
  ],
  "presets": [
    {
      "name": "Product Spectrum Videos"
    }
  ]
}
{% endschema %}